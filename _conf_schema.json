{
  "models": {
    "description": "生成模型",
    "type": "template_list",
    "hint": "每个条目是一个可被 AI 调用的模型。也可以直接在聊天里让机器人帮你配置（管理员）。",
    "templates": {
      "openai_image": {
        "name": "OpenAI 兼容图片（gpt-image / DALL·E / 硅基流动 / Seedream 中转 / 即梦反代 / 聊天出图）",
        "hint": "POST {base}/images/generations（同步）。参考图：edits=multipart /images/edits；json_image=在 body 里带 image 字段（方舟 Seedream、多数中转）；chat=走 /chat/completions 聊天出图",
        "items": {
          "name": {
            "description": "模型名称（唯一，聊天里用这个名字点名）",
            "type": "string",
            "default": ""
          },
          "enabled": {
            "description": "启用",
            "type": "bool",
            "default": true
          },
          "kind": {
            "description": "生成类型",
            "type": "string",
            "options": [
              "image",
              "video"
            ],
            "default": "image"
          },
          "base_url": {
            "description": "接口地址",
            "type": "string",
            "default": "",
            "hint": "默认 https://api.openai.com/v1。留空用官方默认地址；中转/反代/本地服务填完整前缀（含 /v1 等版本段）。插件跑在 Docker 里访问宿主机用 host.docker.internal"
          },
          "api_key": {
            "description": "API Key",
            "type": "string",
            "default": ""
          },
          "model": {
            "description": "模型 ID",
            "type": "string",
            "default": ""
          },
          "description": {
            "description": "给 AI 看的简介（擅长什么、速度、花费）",
            "type": "string",
            "default": "",
            "hint": "例如：写实人像出图好，约 15 秒，免费本地"
          },
          "default_size": {
            "description": "默认尺寸（宽x高）",
            "type": "string",
            "default": ""
          },
          "default_duration": {
            "description": "默认视频时长（秒）",
            "type": "float",
            "default": 0
          },
          "timeout_s": {
            "description": "单个任务总超时（秒，0=图片 300 / 视频 1800）",
            "type": "int",
            "default": 0
          },
          "submit_timeout_s": {
            "description": "提交请求超时（秒，0=全局默认）",
            "type": "int",
            "default": 0
          },
          "poll_interval_s": {
            "description": "轮询间隔（秒，0=按接口默认，会逐步拉长）",
            "type": "float",
            "default": 0
          },
          "max_concurrency": {
            "description": "最大并发（0=图片 2 / 视频 1；ComfyUI 默认 1）",
            "type": "int",
            "default": 0
          },
          "queue_group": {
            "description": "队列分组（同组共享并发上限，如同一块显卡）",
            "type": "string",
            "default": ""
          },
          "fallback": {
            "description": "失败时依次改用的模型（名称，逗号分隔）",
            "type": "string",
            "default": ""
          },
          "proxy": {
            "description": "代理（如 http://127.0.0.1:7890）",
            "type": "string",
            "default": ""
          },
          "cost_hint": {
            "description": "费用说明（给 AI 和用户看）",
            "type": "string",
            "default": ""
          },
          "extra": {
            "description": "额外请求参数（JSON，原样合并进请求体，null 表示删除字段）",
            "type": "text",
            "default": ""
          },
          "path": {
            "description": "生成接口路径",
            "type": "string",
            "default": "/images/generations",
            "hint": "生成接口路径（视频同步接口改成 /videos/generations）"
          },
          "ref_mode": {
            "description": "参考图传法：edits / json_image / chat / none",
            "type": "string",
            "default": "edits",
            "hint": "参考图传法：edits / json_image / chat / none"
          },
          "response_format": {
            "description": "url 或 b64_json；留空则不传",
            "type": "string",
            "default": "",
            "hint": "url 或 b64_json；留空则不传（gpt-image 系列不接受此参数）"
          },
          "size_format": {
            "description": "尺寸写法：wxh / w*h / ratio / none",
            "type": "string",
            "default": "wxh"
          },
          "image_field": {
            "description": "json_image 模式下参考图字段名",
            "type": "string",
            "default": "image"
          }
        }
      },
