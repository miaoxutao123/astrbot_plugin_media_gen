            "default": "GET"
          },
          "poll_body_template": {
            "description": "POST 查询时的请求体模板（可用 {{id}}）",
            "type": "text",
            "default": ""
          },
          "status_path": {
            "description": "状态字段路径",
            "type": "string",
            "default": "status"
          },
          "success_values": {
            "description": "成功状态值（逗号分隔，不区分大小写）",
